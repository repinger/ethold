# ETHOL PENS SSO Credentials
ETHOL_EMAIL=email@student.pens.ac.id
ETHOL_PASSWORD=sso_password

# Optional: Telegram Notifications (leave empty to disable)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: Forum supergroup topic thread IDs (leave empty to use general chat)
TELEGRAM_COMMAND_THREAD_ID=
TELEGRAM_NOTIF_THREAD_ID=

# Optional: Auto-Presence (set to "true" or "1" to enable; disabled by default)
ETHOL_AUTO_PRESENCE=

# Optional: Log level (debug, info, warn, error; defaults to info in release, debug in dev)
LOG_LEVEL=

# Optional: State retention in days (defaults to 90 days; 0 disables auto-pruning)
ETHOL_STATE_RETENTION_DAYS=
